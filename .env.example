# 自建服务器配置示例；设置为服务端进程环境变量。本文件不会自动加载。
MYSQL_ADDRESS=127.0.0.1:3306
MYSQL_DATABASE=jiaoyi_zx
MYSQL_USERNAME=jiaoyi_zx
MYSQL_PASSWORD=
WECHAT_APPID=wxa64654c604b3af31
# 自建 HTTPS 服务保持 false，不信任客户端伪造的微信身份头。
WECHAT_TRUSTED_INGRESS=false
PORT=8082
# 二期管理服务：独立部署，APP_MODE=admin；小程序服务保持 mini。
APP_MODE=mini
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# 上传公开内容图片时，仅在管理服务设置下面的值。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE_URL=

# 自建服务器：设置 server，使用新小程序 AppID 和仅服务端保存的 AppSecret。
WECHAT_AUTH_MODE=server
WECHAT_APPSECRET=

# AI录入助手：仅管理服务填写；模型固定 deepseek-flash。
DEEPSEEK_API_KEY=
