# 仅作参考；请设置为进程或云托管环境变量。本文件不会自动加载。
MYSQL_ADDRESS=127.0.0.1:3306
MYSQL_DATABASE=yiyao
MYSQL_USERNAME=yiyao_app
MYSQL_PASSWORD=
WECHAT_APPID=wx2948f6a7ea6a688b
# 只有关闭全部不可信入口并核实授权后才能设为 true。
WECHAT_TRUSTED_INGRESS=false
PORT=80
# 二期管理服务：独立部署，APP_MODE=admin；小程序服务保持 mini。
APP_MODE=mini
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# 上传公开内容图片时，仅在管理服务设置下面的值。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_SESSION_TOKEN=
COS_BUCKET=
COS_REGION=
COS_PUBLIC_BASE_URL=

# 自建服务器：设置 server，使用新小程序 AppID 和仅服务端保存的 AppSecret。
WECHAT_AUTH_MODE=cloud
WECHAT_APPSECRET=
